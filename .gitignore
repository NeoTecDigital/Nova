# ---------------------------------------------------------------------------
# CMake / build trees
# ---------------------------------------------------------------------------
build/
build-*/
cmake-build-*/
out/build/
CMakeCache.txt
CMakeFiles/
CMakeScripts/
cmake_install.cmake
CTestTestfile.cmake
install_manifest.txt
Testing/
_deps/
Makefile.cmake

# Generated protobuf / IDL output
/protocol/

# Clang / LSP tooling. compile_commands.json is a CMake-generated artifact
# containing absolute, machine-local paths -- regenerate it, never commit it.
compile_commands.json
.cache/
.ccls-cache/
.clangd/

# ---------------------------------------------------------------------------
# Compiled objects, libraries and executables
# ---------------------------------------------------------------------------
*.o
*.obj
*.lo
*.slo
*.ko
*.a
*.la
*.lai
*.so
*.so.*
*.dylib
*.app
*.gch
*.pch

# Committed-by-accident executables (anchored: does NOT match *.cpp sources)
/wavecube_compute

# ---------------------------------------------------------------------------
# Rust (extern/OATS-rs, extern/OATS-ffi)
# ---------------------------------------------------------------------------
target/
**/*.rs.bk
*.pdb

# extern/OATS-ffi is FIRST-PARTY source: track Cargo.toml, Cargo.lock, src/,
# include/ and tests/, but never its 26 MB of cargo build output.
extern/OATS-ffi/lib/
extern/OATS-ffi/target/

# ---------------------------------------------------------------------------
# Go (extern/lumberjack is a submodule, but keep local builds out regardless)
# ---------------------------------------------------------------------------
*.test
*.prof
vendor/

# ---------------------------------------------------------------------------
# Tooling / agent scratch state
# ---------------------------------------------------------------------------
.shamash/
scanner_cache/

# ---------------------------------------------------------------------------
# Runtime-generated application state
# ---------------------------------------------------------------------------
imgui.ini

# ---------------------------------------------------------------------------
# Editors / IDEs
# ---------------------------------------------------------------------------
# .vscode/settings.json is deliberately TRACKED (shared project config);
# everything else under .vscode/ is machine-local.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.vs/
.idea/
*.iml
*.swp
*.swo
*~
.#*
\#*\#

# ---------------------------------------------------------------------------
# OS noise
# ---------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# ---------------------------------------------------------------------------
# Logs, cores, temp
# ---------------------------------------------------------------------------
*.log
/core
/core.[0-9]*
/a.out
vgcore.*
*.tmp
*.bak
*.orig
*.rej

# ---------------------------------------------------------------------------
# Generated SPIR-V shader binaries
# ---------------------------------------------------------------------------
# CMake compiles every GLSL source listed in NOVA_SHADER_MAP to SPIR-V at build
# time, so the .spv are derived artifacts. The .vert / .frag / .comp GLSL
# sources are the tracked inputs and are untouched by this rule.
*.spv
