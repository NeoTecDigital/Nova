# Written by Richard Christopher, Copyright 2026 NeoTec Digital

# ---------------------------------------------------------------------------
# Scratch space
#
# Anchored at the repository root, so it never swallows a `scratchpad/` a
# subdirectory might legitimately want. Nothing under it has ever been tracked;
# this rule exists so that an agent or a developer dropping a build tree or a
# throwaway probe here cannot accidentally stage half a gigabyte. Work that is
# worth keeping goes in tests/integration/, not here - that is the whole lesson
# of the harnesses this repository lost when a scratch directory was swept.
# ---------------------------------------------------------------------------
/scratchpad/

# ---------------------------------------------------------------------------
# CMake / build trees
# ---------------------------------------------------------------------------
build/
build-*/
cmake-build-*/
out/build/
CMakeCache.txt
CMakeFiles/
CMakeScripts/
cmake_install.cmake
CTestTestfile.cmake
install_manifest.txt
Testing/
_deps/
Makefile.cmake

# Generated protobuf / IDL output
/protocol/

# Clang / LSP tooling. compile_commands.json is a CMake-generated artifact
# containing absolute, machine-local paths -- regenerate it, never commit it.
compile_commands.json
.cache/
.ccls-cache/
.clangd/

# ---------------------------------------------------------------------------
# Compiled objects, libraries and executables
# ---------------------------------------------------------------------------
*.o
*.obj
*.lo
*.slo
*.ko
*.a
*.la
*.lai
*.so
*.so.*
*.dylib
*.app
*.gch
*.pch

# Committed-by-accident executables (anchored: does NOT match *.cpp sources).
# Two anchors, both load-bearing: the source moved to Nova/ with the rest of the
# layer, so that is where an in-tree build lands now - but an untracked binary
# from before the move still sits at the root, and dropping its rule would stage
# it on the next `git add -A`.
/wavecube_compute
/Nova/wavecube_compute

# ---------------------------------------------------------------------------
# Rust (extern/OATS-rs, extern/OATS-ffi)
# ---------------------------------------------------------------------------
target/
**/*.rs.bk
*.pdb

# extern/OATS-ffi is FIRST-PARTY source: track Cargo.toml, Cargo.lock, src/,
# include/ and tests/, but never its 26 MB of cargo build output.
extern/OATS-ffi/lib/
extern/OATS-ffi/target/

# ---------------------------------------------------------------------------
# Go (extern/lumberjack is a submodule, but keep local builds out regardless)
# ---------------------------------------------------------------------------
*.test
*.prof
vendor/

# ---------------------------------------------------------------------------
# Tooling / agent scratch state
# ---------------------------------------------------------------------------
.shamash/
scanner_cache/

# ---------------------------------------------------------------------------
# Runtime-generated application state
# ---------------------------------------------------------------------------
imgui.ini

# ---------------------------------------------------------------------------
# Editors / IDEs
# ---------------------------------------------------------------------------
# .vscode/settings.json is deliberately TRACKED (shared project config);
# everything else under .vscode/ is machine-local.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.vs/
.idea/
*.iml
*.swp
*.swo
*~
.#*
\#*\#

# ---------------------------------------------------------------------------
# OS noise
# ---------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# ---------------------------------------------------------------------------
# Logs, cores, temp
# ---------------------------------------------------------------------------
*.log
/core
/core.[0-9]*
/a.out
vgcore.*
*.tmp
*.bak
*.orig
*.rej

# ---------------------------------------------------------------------------
# Generated SPIR-V shader binaries
# ---------------------------------------------------------------------------
# CMake compiles every GLSL source listed in NOVA_SHADER_MAP to SPIR-V at build
# time, so the .spv are derived artifacts. The .vert / .frag / .comp GLSL
# sources are the tracked inputs and are untouched by this rule.
*.spv
